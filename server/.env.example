PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/multivisons
# Long random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
SIGNATURE_SECRET=change-me-too
CLIENT_ORIGIN=http://localhost:5173

# AI completion check (optional). Without a key a transparent keyword heuristic is used and payments are never auto-released.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Percent of acceptance criteria that must be met for the AI to release payment
RELEASE_THRESHOLD=85
# ai (default): auto-release only when the real AI model scored it. always: also auto-release on heuristic scores (demo only).
AUTO_RELEASE=ai

# PayPal sandbox (optional). Without these, payments are simulated and labelled as such.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Comma-separated emails that become administrators when they register or sign in
ADMIN_EMAILS=
